# Rendered by Ansible. Do not edit by hand.
name: app

services:
  postgres:   # TimescaleDB
    container_name: "app_postgres"
    image: {{ postgres_image }}
    restart: unless-stopped # If the container exits, restart it unless it was stopped manually.
    env_file: ./env/postgres.env
    networks: [backend]
    volumes:
      - postgres_data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  mosquitto:
    container_name: "app_mosquitto"
    image: {{ mosquitto_image }}
    restart: unless-stopped
    networks: [backend]
    volumes:
      - ./mosquitto/mosquitto.conf:/mosquitto/config/mosquitto.conf:ro
      - {{ tls_cert_dir }}/{{ tls_cert_file }}:/mosquitto/certs/tracker.crt:ro
      - {{ tls_cert_dir }}/{{ tls_key_file }}:/mosquitto/certs/tracker.key:ro
      - {{ tls_cert_dir }}/{{ identity_ca_cert_file }}:/mosquitto/certs/identity-service.crt:ro
      - mosquitto_data:/mosquitto/data
    healthcheck:
      test: ["CMD-SHELL", "mosquitto_pub -h localhost -t healthcheck -m ok"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

networks:
  backend:
    driver: bridge

volumes:
  postgres_data:
  mosquitto_data: